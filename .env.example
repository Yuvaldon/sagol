# Every environment variable of Sagol. Copy to `.env.local` for development.
# The env Zod schema lives in `src/config` (session 1.4); `src/app` parses it at startup
# and fails fast on invalid values. Only `VITE_`-prefixed variables reach the client.

# Identity provider: `local` (development only, D-006) or `google` (phase 8).
# A production build refuses `local` (vite.config.ts, productionEnvGuard).
VITE_AUTH_MODE=local

# Data adapter: `local` (IndexedDB, D-021) or `remote` (phase 8).
VITE_DATA_ADAPTER=local

# Remote backend (phase 8, D-027). Empty while the data adapter is local.
VITE_REMOTE_URL=
VITE_REMOTE_ANON_KEY=

# Server-only secret (D-005). Set in the backend environment, never with a VITE_ prefix,
# so it never reaches the client bundle. Listed here for completeness.
# BOOTSTRAP_OWNER_EMAIL=
