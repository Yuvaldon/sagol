{
  "name": "sagol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:function": "node scripts/build-function.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings && node scripts/lint-custom.ts",
    "check:layers": "depcruise src --config .dependency-cruiser.cjs",
    "check:raw-values": "node scripts/check-raw-values.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "test": "vitest run --passWithNoTests --project unit --project dom",
    "seed:staging": "node scripts/seed-staging.ts",
    "test:db": "node scripts/db-reset.ts && node scripts/db-schema-drift.ts && vitest run --project db",
    "test:rest": "vitest run --project rest",
    "check": "npm run typecheck && npm run lint && npm run check:layers && npm run check:raw-values && npm run check:i18n && npm run test",
    "prepare": "lefthook install",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/heebo": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@supabase/auth-js": "2.118.0",
    "@supabase/realtime-js": "2.118.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "dexie": "4.4.7",
    "lucide-react": "1.67.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "dependency-cruiser": "18.7.2",
    "fake-indexeddb": "6.2.8",
    "jsdom": "29.1.1",
    "lefthook": "2.2.2",
    "oxlint": "1.91.0",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
